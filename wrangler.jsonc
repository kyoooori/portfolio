{
  "name": "portfolio",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-01",

  "assets": {
    // The site's HTML, CSS and media live in the repo root
    "directory": ".",
    "binding": "ASSETS",
    // Lets the password check run before pages are served
    "run_worker_first": true
  },

  // Keeps keyuritatu.com attached to this Worker on every deploy
  "routes": [
    { "pattern": "keyuritatu.com", "custom_domain": true }
  ]
}
